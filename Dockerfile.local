# syntax=docker/dockerfile:1
#
# Local sandbox image for `smelt factory --backend docker`.
#
# This is the environment a factory *sidecar* runs in — the box the AI agent
# edits code on and where your tests run. Build it once, then point the factory
# at it:
#
#     docker build -t smelt-sandbox:local -f Dockerfile.local .
#     smelt factory build --backend docker --image smelt-sandbox:local "your task"
#
# It carries what the loop needs (git, coreutils, procps, the Claude Code and Codex CLIs)
# plus smelt's own toolchain so the project's validation commands run in the
# sidecar: Go (matching go.mod), Task, and uv/python for the harness lint step.
# `task test`/`lint`/`fmt` fetch gotestsum, golangci-lint and gosimports via
# `go tool`, so those need no separate install.
#
# The repo is NOT copied in at build time — the Docker backend bind-mounts a
# fresh copy of your working tree into the container at run time. So this image
# only needs tools, never your source. (The file transport is host-side; the
# rsync and ssh below are only for smelt's own tests.)

FROM debian:bookworm-slim

ENV HOME=/root \
    DEBIAN_FRONTEND=noninteractive \
    GOTOOLCHAIN=auto \
    CGO_ENABLED=1 \
    PATH=/root/.local/bin:/usr/local/go/bin:/root/go/bin:/usr/local/bin:/usr/bin:/bin

# Base tools: the loop's own scripts (git, sha256sum/base64 from coreutils,
# pkill from procps), curl/ca-certificates for installers, python3 for the
# harness lint step, gcc + libc6-dev because `task test` runs with -race,
# which needs cgo, and rsync + openssh-client because the pooled-validation
# tests skip themselves without them.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      coreutils \
      procps \
      ca-certificates \
      curl \
      bash \
      python3 \
      python3-venv \
      gcc \
      libc6-dev \
      rsync \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Go — matches go.mod's version, architecture-detected so the image builds on
# both amd64 and arm64 (Apple Silicon) Docker.
ARG GO_VERSION=1.26.1
RUN arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) goarch=amd64 ;; \
      arm64) goarch=arm64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz" | tar -C /usr/local -xz \
 && go version

# Task (task test/lint/fmt runner) and uv (runs the harness's pylint step).
RUN sh -c "$(curl -fsSL https://taskfile.dev/install.sh)" -- -d -b /usr/local/bin \
 && task --version \
 && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
 && uv --version

# -- Extra project toolchain -------------------------------------------------
# smelt needs only Go + Task + uv (above). For other repos, add their test
# dependencies here (node, rust, system libs, …).
# ---------------------------------------------------------------------------

# Claude Code CLI. The native installer drops `claude` in $HOME/.local/bin,
# which is exactly where the factory's scripts look (they prepend it to PATH).
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && test -x /root/.local/bin/claude

# OpenAI Codex CLI, the second coding agent the factory can drive. Installed
# from the pinned GitHub release into $HOME/.local/bin next to claude, along
# with codex-code-mode-host, the program Codex runs every command through.
# Keep these blocks identical to sandboximage.KitCodex (a test checks).
RUN set -e; \
    case "$(uname -m)" in \
      x86_64) arch=x86_64; sum=8daf67f6261161aa5939d8d42a516032d760406216779d7ce6040f242140ff73 ;; \
      aarch64|arm64) arch=aarch64; sum=15162a9b59edf8e512b27414ec0b7db22e6424a1262b0eee8666643e0d295c2f ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    name="codex-${arch}-unknown-linux-musl"; \
    curl -fsSL -o "/tmp/${name}.tar.gz" "https://github.com/openai/codex/releases/download/rust-v0.162.0/${name}.tar.gz"; \
    echo "${sum}  /tmp/${name}.tar.gz" | sha256sum -c -; \
    mkdir -p "$HOME/.local/bin"; \
    tar -xzf "/tmp/${name}.tar.gz" -C /tmp; \
    mv "/tmp/${name}" "$HOME/.local/bin/codex"; \
    rm -f "/tmp/${name}.tar.gz"; \
    test -x "$HOME/.local/bin/codex"
RUN set -e; \
    case "$(uname -m)" in \
      x86_64) arch=x86_64; sum=dee8bf3df637c68e1495b928d643b76d4ad44f94e4f0ed79fe8482fa79e23d97 ;; \
      aarch64|arm64) arch=aarch64; sum=18d99b055d2ef4a2af51f1144919bd8a208f4f79ace389b7775341d6903cf7e9 ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    name="codex-code-mode-host-${arch}-unknown-linux-musl"; \
    curl -fsSL -o "/tmp/${name}.tar.gz" "https://github.com/openai/codex/releases/download/rust-v0.162.0/${name}.tar.gz"; \
    echo "${sum}  /tmp/${name}.tar.gz" | sha256sum -c -; \
    mkdir -p "$HOME/.local/bin"; \
    tar -xzf "/tmp/${name}.tar.gz" -C /tmp; \
    mv "/tmp/${name}" "$HOME/.local/bin/codex-code-mode-host"; \
    rm -f "/tmp/${name}.tar.gz"; \
    test -x "$HOME/.local/bin/codex-code-mode-host"

# lizard, which measures code quality in any language: a pinned, hash-checked
# install into a venv. Keep this block identical to sandboximage.KitLizard.
RUN set -e; \
    if ! command -v python3 >/dev/null 2>&1; then \
      echo "warning: python3 is missing, so lizard is not installed and code quality is not measured" >&2; exit 0; \
    fi; \
    python3 -m venv "$HOME/.local/share/smelt-tools"; \
    printf '%s\n' 'lizard==1.24.1 --hash=sha256:746060a3e9a375af7340b2d4c6aab307b8a8b4199339c36ddc7afc4188b53d1c' 'pygments==2.21.0 --hash=sha256:2363c69b61c4a97c838da3b130dcd6468f4848992b21a82f2a63ec34377137d9' 'pathspec==1.1.1 --hash=sha256:a00ce642f577bf7f473932318056212bc4f8bfdf53128c78bbd5af0b9b20b189' > /tmp/lizard-requirements.txt; \
    "$HOME/.local/share/smelt-tools/bin/pip" install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/lizard-requirements.txt; \
    rm -f /tmp/lizard-requirements.txt; \
    mkdir -p "$HOME/.local/bin"; \
    ln -sf "$HOME/.local/share/smelt-tools/bin/lizard" "$HOME/.local/bin/lizard"; \
    lizard --version

LABEL smelt.harnesses=claude,codex smelt.kit=4

# The factory keeps the container alive and execs commands into it.
CMD ["sleep", "infinity"]
