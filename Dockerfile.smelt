# syntax=docker/dockerfile:1
# Factory sandbox for `smelt factory build --backend docker`.
# Generated by `smelt init`; edit freely, smelt will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM cimg/go:1.26.0
ENV PATH=/home/circleci/.local/bin:$PATH

# --- toolchain -------------------------------------------------------------
USER root
# build-essential supplies the C compiler required by Go's race detector.
# The Docker CLI (docker-ce-cli), shellcheck and ssh come with the base image;
# Ubuntu's docker.io would conflict with its containerd.io. Tests still need a
# reachable Docker daemon.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates procps coreutils bash build-essential rsync \
 && rm -rf /var/lib/apt/lists/*
USER circleci
RUN go install github.com/go-task/task/v3/cmd/task@v3.45.4
# uv runs the Python harness scripts (`task lint` -> `uv run --project harness pylint`).
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 UV_INSTALL_DIR="$HOME/.local/bin" sh \
 && uv --version \
 && uv python install 3.12

# --- dependencies: rebuilt when these files change -------------------------
COPY --chown=circleci go.mod go.sum /tmp/smelt-deps/
RUN cd /tmp/smelt-deps && go mod download && rm -rf /tmp/smelt-deps
# Warm the uv cache so `uv run --project harness` can build its venv in the bind-mounted repo without re-downloading.
COPY --chown=circleci harness/pyproject.toml harness/uv.lock /tmp/smelt-harness-deps/
RUN cd /tmp/smelt-harness-deps && uv sync --frozen --no-install-project && rm -rf /tmp/smelt-harness-deps
