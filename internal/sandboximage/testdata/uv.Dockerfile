# syntax=docker/dockerfile:1
# Factory sandbox for `smelt factory build --backend docker`.
# Generated by `smelt init`; edit freely, smelt will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM python:3.12
ENV UV_CACHE_DIR=/root/.cache/uv
ENV UV_LINK_MODE=copy
ENV PATH=/root/.local/bin:$PATH

# --- dependencies: rebuilt when these files change -------------------------
COPY pyproject.toml uv.lock /tmp/smelt-deps/
RUN cd /tmp/smelt-deps && uv sync --frozen --no-install-project && rm -rf /tmp/smelt-deps
