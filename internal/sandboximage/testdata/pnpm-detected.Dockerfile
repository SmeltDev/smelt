# syntax=docker/dockerfile:1
# Factory sandbox for `smelt factory build --backend docker`.
# Generated by `smelt init`; edit freely, smelt will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM cimg/node:22.12
ENV pnpm_config_store_dir=/home/circleci/.local/share/pnpm/store
ENV PATH=/home/circleci/.local/bin:$PATH

# --- toolchain -------------------------------------------------------------
USER root
RUN sudo npm install -g pnpm
USER circleci

# --- dependencies: rebuilt when these files change -------------------------
COPY --chown=circleci package.json pnpm-lock.yaml /tmp/smelt-deps/
RUN cd /tmp/smelt-deps && corepack enable --install-directory ~/bin && pnpm fetch && rm -rf /tmp/smelt-deps
